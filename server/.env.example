# Copy to your process environment (or a service manager config) for production.

NODE_ENV=production
PORT=4000

# Required in production: at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional: if unset, a secret is generated once and stored in the database.
# JWT_SECRET=

# PostgreSQL connection. If unset, an embedded PostgreSQL (PGlite) database is stored in PGLITE_DIR.
DATABASE_URL=postgres://jpm:password@localhost:5432/jpm_purchase
# PGLITE_DIR=./data/pglite

# Where uploaded attachments and voice notes are stored (private — never served directly).
# STORAGE_DIR=./data/uploads

# Business timezone for "today", due dates and date filters.
APP_TIMEZONE=Asia/Kolkata

# Reminders: urgent tasks not yet acknowledged are reminded every N minutes, at most M times.
URGENT_REMINDER_MINUTES=10
URGENT_REMINDER_MAX=6
# How often the server checks for reminders (seconds; 0 disables).
REMINDER_CHECK_SECONDS=60

# Push alerts via Firebase Cloud Messaging (optional; both required to enable).
# Firebase console → Project settings → Cloud Messaging → Web Push certificates → public key:
# FIREBASE_VAPID_KEY=
# Firebase console → Project settings → Service accounts → Generate new private key (JSON).
# Paste the whole JSON, or base64 of it. SECRET — never commit it.
# FIREBASE_SERVICE_ACCOUNT=

# Set to 1 to load demo sections, users and tasks into an empty production database.
# SEED_DEMO=1
